@use 'variaveis';

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: variaveis.$corPrincipal;
}

.container {
    width: 100vw;
    height: 100vh;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
}

.zoom-text {
    color: #fff;
    animation: zoom 2s infinite;
  }

  @keyframes zoom {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.5); }
  }

